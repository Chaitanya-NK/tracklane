# Copy to .env (the dev container does this for you on first start).

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001
# Date and number format (BCP 47), e.g. en-US, en-GB, de-DE. Defaults to en-IN.
NEXT_PUBLIC_APP_LOCALE=en-IN

# --- Auth (Better Auth). setup.sh generates the secret; or run: openssl rand -base64 32 ---
BETTER_AUTH_SECRET=

# Optional OAuth sign-in. Leave blank to hide the buttons. Both providers are free.
# GitHub: Settings → Developer settings → OAuth Apps; callback <APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: console.cloud.google.com → Credentials; callback <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database (docker compose service "postgres") ---
DATABASE_URL=postgresql://tracklane:tracklane@localhost:5432/tracklane

# --- File storage (attachments). Local disk by default; relative paths are from the repo root ---
STORAGE_DIR=.data/uploads
# Largest attachment accepted, in megabytes
MAX_UPLOAD_MB=10

# --- Email (docker compose service "mailpit"; web inbox on :8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Tracklane <no-reply@tracklane.local>"

# --- Realtime server ---
REALTIME_PORT=4001
# Where the web server forwards /api/realtime (the browser never connects to it directly)
REALTIME_INTERNAL_URL=http://localhost:4001
# Where the worker calls the web app's internal endpoints (SLA checks)
INTERNAL_APP_URL=http://localhost:3000

# --- Notifications ---
# Web Push keys (setup.sh generates them). Leave blank to turn browser push off.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@tracklane.local
# Block sign-in until the email address is confirmed (true/false)
REQUIRE_EMAIL_VERIFICATION=false

# --- Webhooks. Allow localhost/private-network targets (keep false in production) ---
WEBHOOK_ALLOW_PRIVATE_URLS=true

