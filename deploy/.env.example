# Production settings for deploy/docker-compose.yml. Copy to deploy/.env and fill in.
# Lines marked REQUIRED must be set. Never commit deploy/.env.

# ── Address ──────────────────────────────────────────────────────────────────
# REQUIRED. The domain Caddy serves and gets a certificate for (DNS A record → this server).
DOMAIN=tracklane.example.com
# REQUIRED. Public URL, https, no trailing slash. Baked into the build: rebuild after changing.
NEXT_PUBLIC_APP_URL=https://tracklane.example.com

# ── Secrets ──────────────────────────────────────────────────────────────────
# REQUIRED. Signs sessions and internal calls. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# REQUIRED for the bundled database. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# Optional: use a managed Postgres instead (needs the pgvector and citext extensions).
# DATABASE_URL=postgresql://user:password@host:5432/tracklane?sslmode=require

# ── Email (invitations, password resets, notifications, digests) ─────────────
# Strongly recommended. Any SMTP provider works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Tracklane <no-reply@tracklane.example.com>"

# ── Sign in with Google / GitHub (optional) ──────────────────────────────────
# Callback URLs: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google and …/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Browser push notifications (optional) ────────────────────────────────────
# Generate once: npx web-push generate-vapid-keys. The public key is baked into the build.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tracklane.example.com

# ── Behaviour (optional) ─────────────────────────────────────────────────────
# Date/number format, e.g. en-US, en-GB. Baked into the build.
NEXT_PUBLIC_APP_LOCALE=en-IN
# Require people to confirm their email before signing in (needs SMTP).
REQUIRE_EMAIL_VERIFICATION=false
# Largest attachment, in MB.
MAX_UPLOAD_MB=10
# Keep false in production: blocks webhooks to private/internal addresses.
WEBHOOK_ALLOW_PRIVATE_URLS=false
# debug | info | warn | error (realtime and worker logs)
LOG_LEVEL=info
