// Tracklane database schema.
// Conventions: cuid string ids, camelCase fields mapped to snake_case columns, plural table names.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Key/value settings for the whole installation (e.g. schema version, feature flags).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity (managed by Better Auth — field names must match Better Auth's schema)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  /// Always stored lowercase (normalised by Better Auth and our services).
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  /// Workspace opened most recently; "/" redirects there.
  lastWorkspaceId String? @map("last_workspace_id")

  sessions            Session[]
  accounts            Account[]
  memberships         WorkspaceMember[]
  invitationsSent     WorkspaceInvitation[]    @relation("InvitedBy")
  workspacesCreated   Workspace[]              @relation("WorkspaceCreatedBy")
  projectsLed         Project[]                @relation("ProjectLead")
  projectsCreated     Project[]                @relation("ProjectCreatedBy")
  issuesAssigned      Issue[]                  @relation("IssueAssignee")
  issuesReported      Issue[]                  @relation("IssueReporter")
  comments            Comment[]
  commentReactions    CommentReaction[]
  componentsLed       ProjectComponent[]
  sprintCapacities    SprintCapacity[]
  attachments         Attachment[]
  issueActivities     IssueActivity[]
  savedFilters        SavedFilter[]
  filterFavorites     FilterFavorite[]
  filterSubscriptions FilterSubscription[]
  projectViews        ProjectView[]
  approvalsRequested  ApprovalRequest[]        @relation("ApprovalRequester")
  approvalsDecided    ApprovalRequest[]        @relation("ApprovalDecider")
  fieldValues         IssueFieldValue[]
  tqlFunctions        TqlFunction[]
  notifications       Notification[]           @relation("NotificationRecipient")
  notificationsSent   Notification[]           @relation("NotificationActor")
  watching            IssueWatcher[]
  notificationPrefs   NotificationPreference[]
  pushSubscriptions   PushSubscription[]
  worklogs            Worklog[]
  dashboards          Dashboard[]
  goalsOwned          Goal[]
  issueLinksCreated   IssueLink[]
  automationRules     AutomationRule[]
  docsCreated         Doc[]                    @relation("DocCreatedBy")
  docsUpdated         Doc[]                    @relation("DocUpdatedBy")
  docVersions         DocVersion[]
  whiteboards         Whiteboard[]
  retrosCreated       Retro[]
  retroCards          RetroCard[]
  retroVotes          RetroVote[]
  pokerSessions       PokerSession[]
  pokerVotes          PokerVote[]
  apiTokens           ApiToken[]
  webhooksCreated     Webhook[]
  incidentsCreated    Incident[]
  incidentUpdates     IncidentUpdate[]
  timeOff             TimeOff[]
  timesheets          TimesheetSubmission[]    @relation("TimesheetOwner")
  timesheetsReviewed  TimesheetSubmission[]    @relation("TimesheetReviewer")
  activeTimer         ActiveTimer?

  @@map("users")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  /// Password hash for the "credential" provider.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Workspaces
// ─────────────────────────────────────────────────────────────────────────────

/// Mirrors WORKSPACE_ROLES in @tracklane/core.
enum WorkspaceRole {
  owner
  admin
  member
  viewer
  guest
}

model Workspace {
  id               String   @id @default(cuid())
  name             String
  /// URL segment: tracklane.app/<slug>/…
  slug             String   @unique
  /// Anyone can see /status/<slug> when true.
  statusPagePublic Boolean  @default(false) @map("status_page_public")
  createdById      String?  @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  createdBy        User?                 @relation("WorkspaceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members          WorkspaceMember[]
  invitations      WorkspaceInvitation[]
  projects         Project[]
  issues           Issue[]
  savedFilters     SavedFilter[]
  tqlFunctions     TqlFunction[]
  resolutions      Resolution[]
  notifications    Notification[]
  dashboards       Dashboard[]
  goals            Goal[]
  docs             Doc[]
  whiteboards      Whiteboard[]
  retros           Retro[]
  pokerSessions    PokerSession[]
  apiTokens        ApiToken[]
  webhooks         Webhook[]
  statusComponents StatusComponent[]
  incidents        Incident[]
  timeOff          TimeOff[]
  timesheets       TimesheetSubmission[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(member)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  /// Lowercased email of the invitee.
  email       String
  role        WorkspaceRole @default(member)
  /// SHA-256 of the token sent by email; the raw token is never stored.
  tokenHash   String        @unique @map("token_hash")
  invitedById String?       @map("invited_by_id")
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  revokedAt   DateTime?     @map("revoked_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([email])
  @@map("workspace_invitations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Projects and issues
// ─────────────────────────────────────────────────────────────────────────────

/// Mirrors PROJECT_TYPES in @tracklane/core.
enum ProjectType {
  scrum
  kanban
}

/// Mirrors STATUS_CATEGORIES in @tracklane/core.
enum StatusCategory {
  todo
  in_progress
  done
}

/// Mirrors ISSUE_TYPES in @tracklane/core.
enum IssueType {
  story
  task
  bug
  epic
  subtask
}

/// Mirrors PRIORITIES in @tracklane/core.
enum Priority {
  lowest
  low
  medium
  high
  highest
}

model Project {
  id                  String      @id @default(cuid())
  workspaceId         String      @map("workspace_id")
  /// Prefix of issue keys (PAY → PAY-12). Unique per workspace, fixed after creation.
  key                 String
  name                String
  description         String      @default("")
  type                ProjectType @default(scrum)
  leadId              String?     @map("lead_id")
  /// Last issue number handed out; incremented atomically when an issue is created.
  issueCounter        Int         @default(0) @map("issue_counter")
  /// Last sprint number handed out ("WEB Sprint 4").
  sprintCounter       Int         @default(0) @map("sprint_counter")
  /// When true, only transitions listed in workflow_transitions are allowed; otherwise any → any.
  restrictTransitions Boolean     @default(false) @map("restrict_transitions")
  /// Kanban only: issues in this status live in the Backlog tab instead of on the board.
  backlogStatusId     String?     @unique @map("backlog_status_id")
  /// Public request form at /portal/<workspace>/<key>.
  portalEnabled       Boolean     @default(false) @map("portal_enabled")
  /// Public roadmap at /roadmap/<workspace>/<key>.
  roadmapPublic       Boolean     @default(false) @map("roadmap_public")
  createdById         String?     @map("created_by_id")
  archivedAt          DateTime?   @map("archived_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead            User?                @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  createdBy       User?                @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  statuses        WorkflowStatus[]
  issues          Issue[]
  labels          Label[]
  sprints         Sprint[]
  transitions     WorkflowTransition[]
  customFields    CustomField[]
  snapshots       ProjectSnapshot[]
  slaPolicies     SlaPolicy[]
  releases        Release[]
  automationRules AutomationRule[]
  recurringIssues RecurringIssue[]
  issueTypes      ProjectIssueType[]
  docs            Doc[]
  whiteboards     Whiteboard[]
  retros          Retro[]
  pokerSessions   PokerSession[]
  portalRequests  PortalRequest[]
  views           ProjectView[]
  components      ProjectComponent[]
  backlogStatus   WorkflowStatus?      @relation("ProjectBacklogStatus", fields: [backlogStatusId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, key])
  @@map("projects")
}

/// A column of the project's workflow (To Do, In Progress…). Order is `position`.
model WorkflowStatus {
  id        String         @id @default(cuid())
  projectId String         @map("project_id")
  name      String
  category  StatusCategory
  position  Int
  /// Most issues the board column should hold (null = no limit).
  wipLimit  Int?           @map("wip_limit")
  createdAt DateTime       @default(now()) @map("created_at")

  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues          Issue[]
  transitionsFrom WorkflowTransition[] @relation("TransitionFrom")
  transitionsTo   WorkflowTransition[] @relation("TransitionTo")
  backlogOf       Project?             @relation("ProjectBacklogStatus")
  approvalsFrom   ApprovalRequest[]    @relation("ApprovalFrom")
  approvalsTo     ApprovalRequest[]    @relation("ApprovalTo")

  @@unique([projectId, name])
  @@map("workflow_statuses")
}

model Issue {
  id           String    @id @default(cuid())
  /// Denormalised from the project so cross-project queries ("assigned to me") stay cheap.
  workspaceId  String    @map("workspace_id")
  projectId    String    @map("project_id")
  /// Sequential per project; the issue key is `${project.key}-${number}`.
  number       Int
  type         IssueType @default(task)
  title        String
  /// Markdown.
  description  String    @default("")
  statusId     String    @map("status_id")
  priority     Priority  @default(medium)
  assigneeId   String?   @map("assignee_id")
  reporterId   String?   @map("reporter_id")
  /// Epic for stories/tasks/bugs, or the parent of a subtask.
  parentId     String?   @map("parent_id")
  /// Planned start (timeline). Due date is the planned end.
  startDate    DateTime? @map("start_date") @db.Date
  dueDate      DateTime? @map("due_date") @db.Date
  /// Story points.
  estimate     Int?
  /// Fix version: the release this issue ships in.
  releaseId    String?   @map("release_id")
  /// A project-defined type (Spike, Incident…) refining the base `type`.
  customTypeId String?   @map("custom_type_id")
  /// Original time estimate, in minutes (time tracking).
  timeEstimate Int?      @map("time_estimate")
  /// Rank within the project: one ordering shared by the board and the backlog.
  position     Float     @default(0)
  /// Null = in the backlog.
  sprintId     String?   @map("sprint_id")
  resolvedAt   DateTime? @map("resolved_at")
  /// How it was resolved (Fixed, Duplicate…). Set while the status is a Done one.
  resolutionId String?   @map("resolution_id")
  /// Flagged as an impediment (shown on board cards).
  flagged      Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  components     IssueComponent[]
  timers         ActiveTimer[]
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resolution     Resolution?       @relation(fields: [resolutionId], references: [id], onDelete: SetNull)
  watchers       IssueWatcher[]
  notifications  Notification[]
  worklogs       Worklog[]
  slaNotices     SlaNotice[]
  release        Release?          @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  customType     ProjectIssueType? @relation(fields: [customTypeId], references: [id], onDelete: SetNull)
  goals          GoalIssue[]
  linksOut       IssueLink[]       @relation("IssueLinkSource")
  linksIn        IssueLink[]       @relation("IssueLinkTarget")
  automationRuns AutomationRun[]
  retroCards     RetroCard[]
  portalRequest  PortalRequest?
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status         WorkflowStatus    @relation(fields: [statusId], references: [id], onDelete: Restrict)
  assignee       User?             @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter       User?             @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  parent         Issue?            @relation("IssueParent", fields: [parentId], references: [id], onDelete: SetNull)
  sprint         Sprint?           @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  children       Issue[]           @relation("IssueParent")
  labels         IssueLabel[]
  comments       Comment[]
  attachments    Attachment[]
  activities     IssueActivity[]
  approvals      ApprovalRequest[]
  fieldValues    IssueFieldValue[]

  @@unique([projectId, number])
  @@index([workspaceId, assigneeId])
  @@index([projectId, statusId])
  @@index([parentId])
  @@index([sprintId])
  @@index([projectId, position])
  @@index([resolutionId])
  @@index([releaseId])
  @@map("issues")
}

model Label {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  name      String
  /// One of the palette names in @tracklane/core (LABEL_COLORS).
  color     String   @default("gray")
  createdAt DateTime @default(now()) @map("created_at")

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  IssueLabel[]

  @@unique([projectId, name])
  @@map("labels")
}

model IssueLabel {
  issueId String @map("issue_id")
  labelId String @map("label_id")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId])
  @@map("issue_labels")
}

model Comment {
  id        String    @id @default(cuid())
  issueId   String    @map("issue_id")
  authorId  String?   @map("author_id")
  /// Markdown.
  body      String
  /// Replies point at the top-level comment they answer.
  parentId  String?   @map("parent_id")
  editedAt  DateTime? @map("edited_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  issue     Issue             @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent    Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("CommentReplies")
  reactions CommentReaction[]

  @@index([issueId, createdAt])
  @@index([parentId])
  @@map("comments")
}

/// An emoji reaction on a comment (one per person per emoji).
model CommentReaction {
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId, emoji])
  @@map("comment_reactions")
}

/// A part of the product (API, Checkout…) issues can belong to.
model ProjectComponent {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  name        String
  description String   @default("")
  leadId      String?  @map("lead_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lead    User?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  issues  IssueComponent[]

  @@unique([projectId, name])
  @@map("project_components")
}

model IssueComponent {
  issueId     String @map("issue_id")
  componentId String @map("component_id")

  issue     Issue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  component ProjectComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@id([issueId, componentId])
  @@index([componentId])
  @@map("issue_components")
}

/// A person's availability for a sprint (planned at sprint start).
model SprintCapacity {
  sprintId String @map("sprint_id")
  userId   String @map("user_id")
  /// Working days the person is away during the sprint.
  daysOff  Int    @default(0) @map("days_off")
  /// Points they can take on; null = derived from recent velocity.
  points   Int?

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sprintId, userId])
  @@map("sprint_capacities")
}

model Attachment {
  id          String   @id @default(cuid())
  issueId     String   @map("issue_id")
  uploaderId  String?  @map("uploader_id")
  filename    String
  contentType String   @map("content_type")
  /// Bytes.
  size        Int
  /// Location in the storage driver (see apps/web/src/server/storage).
  storageKey  String   @unique @map("storage_key")
  createdAt   DateTime @default(now()) @map("created_at")

  issue    Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploader User? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([issueId])
  @@map("attachments")
}

/// The issue's history tab: one row per change. Values are stored as display text so history
/// stays readable after statuses, labels or people are renamed or removed.
model IssueActivity {
  id        String   @id @default(cuid())
  issueId   String   @map("issue_id")
  actorId   String?  @map("actor_id")
  /// created | updated | commented | attachment_added | attachment_removed
  action    String
  field     String?
  fromValue String?  @map("from_value")
  toValue   String?  @map("to_value")
  createdAt DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
  @@map("issue_activities")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sprints
// ─────────────────────────────────────────────────────────────────────────────

enum SprintState {
  planned
  active
  completed
}

model Sprint {
  id               String      @id @default(cuid())
  projectId        String      @map("project_id")
  name             String
  goal             String      @default("")
  state            SprintState @default(planned)
  startDate        DateTime?   @map("start_date") @db.Date
  endDate          DateTime?   @map("end_date") @db.Date
  startedAt        DateTime?   @map("started_at")
  completedAt      DateTime?   @map("completed_at")
  /// Snapshot when the sprint starts / completes, for velocity and sprint reports.
  committedPoints  Int?        @map("committed_points")
  completedPoints  Int?        @map("completed_points")
  completedIssues  Int?        @map("completed_issues")
  incompleteIssues Int?        @map("incomplete_issues")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues     Issue[]
  snapshots  ProjectSnapshot[]
  retros     Retro[]
  capacities SprintCapacity[]

  @@index([projectId, state])
  @@map("sprints")
}

// ─────────────────────────────────────────────────────────────────────────────
// Saved filters
// ─────────────────────────────────────────────────────────────────────────────

/// A named TQL query. Private to its owner unless shared with the workspace.
model SavedFilter {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  ownerId     String   @map("owner_id")
  name        String
  description String   @default("")
  query       String
  shared      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner         User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  favorites     FilterFavorite[]
  subscriptions FilterSubscription[]

  @@index([workspaceId, ownerId])
  @@map("saved_filters")
}

/// A user's starred filters (theirs or shared ones).
model FilterFavorite {
  filterId  String   @map("filter_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  filter SavedFilter @relation(fields: [filterId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([filterId, userId])
  @@index([userId])
  @@map("filter_favorites")
}

enum DigestFrequency {
  daily
  weekly
}

/// Emails a filter's results to a user on a schedule.
model FilterSubscription {
  filterId   String          @map("filter_id")
  userId     String          @map("user_id")
  frequency  DigestFrequency @default(daily)
  lastSentAt DateTime?       @map("last_sent_at")
  createdAt  DateTime        @default(now()) @map("created_at")

  filter SavedFilter @relation(fields: [filterId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([filterId, userId])
  @@index([userId])
  @@map("filter_subscriptions")
}

/// A saved arrangement of a project's issue list: filters, grouping and columns.
model ProjectView {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  ownerId   String   @map("owner_id")
  name      String
  /// The list's query string (status=…&type=…&sort=…), without the view parameter.
  params    String   @default("")
  groupBy   String   @default("none") @map("group_by")
  columns   String[] @default([])
  /// Visible to everyone in the project; otherwise only to the owner.
  shared    Boolean  @default(false)
  /// Others may save changes to a shared view.
  editable  Boolean  @default(false)
  /// Opens by default for everyone (one per project).
  isDefault Boolean  @default(false) @map("is_default")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_views")
}

// ─────────────────────────────────────────────────────────────────────────────
// Workflow and approvals
// ─────────────────────────────────────────────────────────────────────────────

/// An allowed move between two statuses, optionally needing approval.
model WorkflowTransition {
  id               String        @id @default(cuid())
  projectId        String        @map("project_id")
  fromStatusId     String        @map("from_status_id")
  toStatusId       String        @map("to_status_id")
  requiresApproval Boolean       @default(false) @map("requires_approval")
  /// Lowest role that can approve (owner ⊃ admin ⊃ member).
  approverRole     WorkspaceRole @default(admin) @map("approver_role")
  createdAt        DateTime      @default(now()) @map("created_at")

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  from    WorkflowStatus @relation("TransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  to      WorkflowStatus @relation("TransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@unique([fromStatusId, toStatusId])
  @@index([projectId])
  @@map("workflow_transitions")
}

enum ApprovalState {
  pending
  approved
  rejected
  cancelled
}

model ApprovalRequest {
  id            String        @id @default(cuid())
  issueId       String        @map("issue_id")
  fromStatusId  String        @map("from_status_id")
  toStatusId    String        @map("to_status_id")
  approverRole  WorkspaceRole @map("approver_role")
  state         ApprovalState @default(pending)
  requestedById String?       @map("requested_by_id")
  decidedById   String?       @map("decided_by_id")
  decidedAt     DateTime?     @map("decided_at")
  note          String        @default("")
  createdAt     DateTime      @default(now()) @map("created_at")

  issue       Issue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  from        WorkflowStatus @relation("ApprovalFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  to          WorkflowStatus @relation("ApprovalTo", fields: [toStatusId], references: [id], onDelete: Cascade)
  requestedBy User?          @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User?          @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([issueId, state])
  @@index([state])
  @@map("approval_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// Custom fields
// ─────────────────────────────────────────────────────────────────────────────

enum CustomFieldType {
  text
  number
  date
  select
  multiselect
  user
  checkbox
  url
}

model CustomField {
  id          String          @id @default(cuid())
  projectId   String          @map("project_id")
  name        String
  description String          @default("")
  type        CustomFieldType
  required    Boolean         @default(false)
  position    Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  options CustomFieldOption[]
  values  IssueFieldValue[]

  @@unique([projectId, name])
  @@map("custom_fields")
}

model CustomFieldOption {
  id       String @id @default(cuid())
  fieldId  String @map("field_id")
  value    String
  color    String @default("gray")
  position Int    @default(0)

  field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, value])
  @@map("custom_field_options")
}

/// One custom field's value on one issue. Exactly one typed column is used per field type.
model IssueFieldValue {
  issueId     String    @map("issue_id")
  fieldId     String    @map("field_id")
  textValue   String?   @map("text_value")
  numberValue Float?    @map("number_value")
  dateValue   DateTime? @map("date_value") @db.Date
  boolValue   Boolean?  @map("bool_value")
  userId      String?   @map("user_id")
  /// Selected option ids (one for select, any number for multiselect).
  optionIds   String[]  @default([]) @map("option_ids")

  issue Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@id([issueId, fieldId])
  @@index([fieldId])
  @@map("issue_field_values")
}

// ─────────────────────────────────────────────────────────────────────────────
// Custom TQL functions
// ─────────────────────────────────────────────────────────────────────────────

enum TqlFunctionKind {
  /// Expands to a TQL condition: isStale() → updated < -14d AND statusCategory != done
  condition
  /// Expands to a list of values for one field kind: frontendTeam() → priya@…, demo@…
  values
}

model TqlFunction {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  /// Called as name(); letters, digits and underscores, starting with a letter.
  name        String
  description String          @default("")
  kind        TqlFunctionKind
  /// TQL condition (kind = condition).
  body        String          @default("")
  /// Field kind the values are for (kind = values): user, label, project, status, sprint, enum…
  valueKind   String?         @map("value_kind")
  values      String[]        @default([])
  createdById String?         @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, name])
  @@map("tql_functions")
}

/// How an issue was closed. Configurable per workspace (Settings → Resolutions).
model Resolution {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String   @default("")
  position    Int      @default(0)
  /// Used when an issue is moved to Done without picking one (board drag, bulk edit).
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@unique([workspaceId, name])
  @@index([workspaceId, position])
  @@map("resolutions")
}

enum NotificationType {
  assigned
  mentioned
  commented
  status_changed
  approval_requested
  approval_decided
  sla_at_risk
  sla_breached
}

/// Outbox state for a delivery channel. The worker picks up `pending` rows.
enum NotificationDelivery {
  pending
  sent
  skipped
  failed
}

model Notification {
  id          String               @id @default(cuid())
  userId      String               @map("user_id")
  workspaceId String               @map("workspace_id")
  issueId     String?              @map("issue_id")
  actorId     String?              @map("actor_id")
  type        NotificationType
  /// One line, e.g. "Priya moved WEB-4 to Done".
  title       String
  /// Optional excerpt (comment text, rejection reason).
  body        String               @default("")
  /// Path inside the app, e.g. /acme/issues/WEB-4.
  url         String
  readAt      DateTime?            @map("read_at")
  emailState  NotificationDelivery @default(skipped) @map("email_state")
  pushState   NotificationDelivery @default(skipped) @map("push_state")
  createdAt   DateTime             @default(now()) @map("created_at")

  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issue     Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId, readAt, createdAt])
  @@index([emailState, createdAt])
  @@index([pushState, createdAt])
  @@map("notifications")
}

/// People who get updates about an issue (reporter, assignee, commenters, or by choice).
model IssueWatcher {
  issueId   String   @map("issue_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issueId, userId])
  @@index([userId])
  @@map("issue_watchers")
}

/// A user's channels for one notification type. Missing rows use the defaults in @tracklane/core.
model NotificationPreference {
  userId String           @map("user_id")
  type   NotificationType
  inApp  Boolean          @default(true) @map("in_app")
  email  Boolean          @default(false)
  push   Boolean          @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@map("notification_preferences")
}

/// A browser's Web Push subscription.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String    @default("") @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// One row per project per day (UTC), written by the worker; feeds burndown and cumulative flow.
model ProjectSnapshot {
  id               String   @id @default(cuid())
  projectId        String   @map("project_id")
  date             DateTime @db.Date
  /// Issue counts per status id, e.g. {"st_1": 4}.
  statusCounts     Json     @map("status_counts")
  todoCount        Int      @default(0) @map("todo_count")
  inProgressCount  Int      @default(0) @map("in_progress_count")
  doneCount        Int      @default(0) @map("done_count")
  /// The active sprint that day, if any, and its points.
  sprintId         String?  @map("sprint_id")
  sprintScope      Int      @default(0) @map("sprint_scope")
  sprintRemaining  Int      @default(0) @map("sprint_remaining")
  sprintIssues     Int      @default(0) @map("sprint_issues")
  sprintOpenIssues Int      @default(0) @map("sprint_open_issues")
  updatedAt        DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint  Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  @@unique([projectId, date])
  @@index([sprintId, date])
  @@map("project_snapshots")
}

/// Time logged against an issue.
model Worklog {
  id        String   @id @default(cuid())
  issueId   String   @map("issue_id")
  userId    String?  @map("user_id")
  minutes   Int
  /// The day the work was done.
  date      DateTime @db.Date
  note      String   @default("")
  /// Billable to a client (timesheets split billable vs internal).
  billable  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([issueId, date])
  @@index([userId, date])
  @@map("worklogs")
}

enum SlaMetric {
  /// Until someone other than the reporter comments.
  first_response
  /// Until the issue enters a Done status.
  resolution
}

/// A service level target for the issues matching a TQL condition in one project.
model SlaPolicy {
  id            String    @id @default(cuid())
  projectId     String    @map("project_id")
  name          String
  /// TQL condition; the project is added automatically.
  query         String
  metric        SlaMetric
  targetMinutes Int       @map("target_minutes")
  /// "At risk" this long before the target.
  warnMinutes   Int       @default(60) @map("warn_minutes")
  position      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notices SlaNotice[]

  @@unique([projectId, name])
  @@map("sla_policies")
}

/// Remembers which SLA warnings were sent, so each is sent once.
model SlaNotice {
  policyId  String           @map("policy_id")
  issueId   String           @map("issue_id")
  kind      NotificationType
  createdAt DateTime         @default(now()) @map("created_at")

  policy SlaPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  issue  Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([policyId, issueId, kind])
  @@map("sla_notices")
}

model Dashboard {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  ownerId     String?  @map("owner_id")
  name        String
  description String   @default("")
  /// Visible to everyone in the workspace (only the owner and admins edit).
  shared      Boolean  @default(false)
  /// Widgets, in order: [{ id, type, title, size, config }].
  widgets     Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, ownerId])
  @@map("dashboards")
}

enum ReleaseStatus {
  unreleased
  released
  archived
}

/// A version issues ship in (fix version).
model Release {
  id          String        @id @default(cuid())
  projectId   String        @map("project_id")
  name        String
  description String        @default("")
  status      ReleaseStatus @default(unreleased)
  startDate   DateTime?     @map("start_date") @db.Date
  releaseDate DateTime?     @map("release_date") @db.Date
  releasedAt  DateTime?     @map("released_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]
  checklist ReleaseChecklistItem[]

  @@unique([projectId, name])
  @@map("releases")
}

/// A readiness step for a release (QA sign-off, docs, rollback plan…).
model ReleaseChecklistItem {
  id        String   @id @default(cuid())
  releaseId String   @map("release_id")
  text      String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, position])
  @@map("release_checklist_items")
}

/// Days a person is away (holiday, sick, conference). Workload and capacity skip them.
model TimeOff {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  note        String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startDate])
  @@map("time_off")
}

enum TimesheetStatus {
  submitted
  approved
  rejected
}

/// A person's week of logged time sent to an admin for approval.
model TimesheetSubmission {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  userId      String          @map("user_id")
  /// Monday of the week.
  weekStart   DateTime        @map("week_start") @db.Date
  minutes     Int
  status      TimesheetStatus @default(submitted)
  reviewerId  String?         @map("reviewer_id")
  note        String          @default("")
  submittedAt DateTime        @default(now()) @map("submitted_at")
  decidedAt   DateTime?       @map("decided_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("TimesheetOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewer  User?     @relation("TimesheetReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId, weekStart])
  @@index([workspaceId, status])
  @@map("timesheet_submissions")
}

/// A running stopwatch on an issue (one per person).
model ActiveTimer {
  userId    String   @id @map("user_id")
  issueId   String   @map("issue_id")
  startedAt DateTime @default(now()) @map("started_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@map("active_timers")
}

enum GoalStatus {
  on_track
  at_risk
  off_track
  done
}

/// A workspace objective, measured by the issues (usually epics) linked to it.
model Goal {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  ownerId     String?    @map("owner_id")
  name        String
  description String     @default("")
  status      GoalStatus @default(on_track)
  targetDate  DateTime?  @map("target_date") @db.Date
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  issues    GoalIssue[]

  @@index([workspaceId])
  @@map("goals")
}

model GoalIssue {
  goalId    String   @map("goal_id")
  issueId   String   @map("issue_id")
  createdAt DateTime @default(now()) @map("created_at")

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([goalId, issueId])
  @@index([issueId])
  @@map("goal_issues")
}

enum IssueLinkType {
  /// source blocks target
  blocks
  relates
  /// source duplicates target
  duplicates
  /// source clones target
  clones
}

model IssueLink {
  id          String        @id @default(cuid())
  sourceId    String        @map("source_id")
  targetId    String        @map("target_id")
  type        IssueLinkType
  createdById String?       @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  source    Issue @relation("IssueLinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target    Issue @relation("IssueLinkTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([sourceId, targetId, type])
  @@index([targetId])
  @@map("issue_links")
}

enum AutomationTrigger {
  issue_created
  status_changed
  assignee_changed
  priority_changed
  comment_added
  scheduled_daily
}

/// "When <trigger> and the issue matches <condition>, do <actions>."
model AutomationRule {
  id          String            @id @default(cuid())
  projectId   String            @map("project_id")
  name        String
  enabled     Boolean           @default(true)
  trigger     AutomationTrigger
  /// For status_changed: only when moving to this status (null = any).
  toStatusId  String?           @map("to_status_id")
  /// Optional TQL condition the issue must match.
  condition   String            @default("")
  /// [{ type, ...params }] — see features/automation/actions.ts.
  actions     Json
  createdById String?           @map("created_by_id")
  position    Int               @default(0)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  runs      AutomationRun[]

  @@index([projectId, trigger])
  @@map("automation_rules")
}

enum AutomationRunStatus {
  success
  skipped
  failed
}

/// Audit log of rule executions.
model AutomationRun {
  id        String              @id @default(cuid())
  ruleId    String              @map("rule_id")
  issueId   String?             @map("issue_id")
  status    AutomationRunStatus
  message   String              @default("")
  createdAt DateTime            @default(now()) @map("created_at")

  rule  AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  issue Issue?         @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([ruleId, createdAt])
  @@map("automation_runs")
}

enum RecurrenceFrequency {
  daily
  weekly
  monthly
}

/// A template that creates an issue on a schedule.
model RecurringIssue {
  id          String              @id @default(cuid())
  projectId   String              @map("project_id")
  title       String
  description String              @default("")
  type        IssueType           @default(task)
  priority    Priority            @default(medium)
  assigneeId  String?             @map("assignee_id")
  frequency   RecurrenceFrequency
  /// Weekly: ISO weekdays (1 = Monday). Monthly: [day of month].
  days        Int[]
  /// Days until the created issue is due (null = no due date).
  dueInDays   Int?                @map("due_in_days")
  enabled     Boolean             @default(true)
  nextRunAt   DateTime            @map("next_run_at")
  lastRunAt   DateTime?           @map("last_run_at")
  createdById String?             @map("created_by_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
  @@map("recurring_issues")
}

/// A project's own issue type (Spike, Incident…), shown instead of its base type.
model ProjectIssueType {
  id        String    @id @default(cuid())
  projectId String    @map("project_id")
  name      String
  /// The built-in type it behaves like (hierarchy, board, reports).
  baseType  IssueType @map("base_type")
  /// One of LABEL_COLORS.
  color     String    @default("gray")
  /// lucide icon name from ISSUE_TYPE_ICONS in the web app.
  icon      String    @default("square")
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@unique([projectId, name])
  @@map("project_issue_types")
}

/// A Markdown page, in the workspace or a project, optionally nested under another page.
model Doc {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  projectId   String?  @map("project_id")
  parentId    String?  @map("parent_id")
  title       String
  /// Markdown; ```mermaid blocks render as diagrams.
  body        String   @default("")
  /// Bumped on every save; saves name the version they started from to catch conflicts.
  version     Int      @default(1)
  position    Int      @default(0)
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Doc?         @relation("DocTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Doc[]        @relation("DocTree")
  createdBy User?        @relation("DocCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?        @relation("DocUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  versions  DocVersion[]

  @@index([workspaceId, projectId])
  @@index([parentId])
  @@map("docs")
}

/// A saved earlier state of a doc (one per save).
model DocVersion {
  id        String   @id @default(cuid())
  docId     String   @map("doc_id")
  version   Int
  title     String
  body      String
  authorId  String?  @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")

  doc    Doc   @relation(fields: [docId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([docId, version])
  @@map("doc_versions")
}

model Whiteboard {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  projectId   String?  @map("project_id")
  name        String
  /// Excalidraw elements and the app state worth keeping (background colour).
  scene       Json     @default("{}")
  version     Int      @default(1)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("whiteboards")
}

enum RetroPhase {
  brainstorm
  vote
  discuss
  closed
}

model Retro {
  id             String     @id @default(cuid())
  workspaceId    String     @map("workspace_id")
  projectId      String     @map("project_id")
  sprintId       String?    @map("sprint_id")
  name           String
  phase          RetroPhase @default(brainstorm)
  /// [{ id, title, actions?: true }] — cards in an `actions` column can become issues.
  columns        Json
  votesPerPerson Int        @default(5) @map("votes_per_person")
  createdById    String?    @map("created_by_id")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint    Sprint?     @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  createdBy User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  cards     RetroCard[]

  @@index([workspaceId, projectId])
  @@map("retros")
}

model RetroCard {
  id        String   @id @default(cuid())
  retroId   String   @map("retro_id")
  columnId  String   @map("column_id")
  authorId  String?  @map("author_id")
  body      String
  /// Set when an action item was turned into an issue.
  issueId   String?  @map("issue_id")
  createdAt DateTime @default(now()) @map("created_at")

  retro  Retro       @relation(fields: [retroId], references: [id], onDelete: Cascade)
  author User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  issue  Issue?      @relation(fields: [issueId], references: [id], onDelete: SetNull)
  votes  RetroVote[]

  @@index([retroId])
  @@map("retro_cards")
}

model RetroVote {
  cardId    String   @map("card_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  card RetroCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@map("retro_votes")
}

/// A planning-poker room: a queue of issues the team estimates together.
model PokerSession {
  id             String    @id @default(cuid())
  workspaceId    String    @map("workspace_id")
  projectId      String    @map("project_id")
  name           String
  /// Card values offered, e.g. ["1","2","3","5","8","13","?"].
  deck           String[]
  /// Issue ids, in the order they'll be estimated.
  queue          String[]
  currentIssueId String?   @map("current_issue_id")
  revealed       Boolean   @default(false)
  endedAt        DateTime? @map("ended_at")
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  votes     PokerVote[]

  @@index([workspaceId, projectId])
  @@map("poker_sessions")
}

model PokerVote {
  sessionId String   @map("session_id")
  issueId   String   @map("issue_id")
  userId    String   @map("user_id")
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  session PokerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, issueId, userId])
  @@map("poker_votes")
}

enum ApiTokenScope {
  read
  write
}

/// A personal access token for the REST API. Only a hash is stored.
model ApiToken {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  name        String
  /// First characters of the token, shown so people can tell tokens apart.
  prefix      String
  tokenHash   String        @unique @map("token_hash")
  scope       ApiTokenScope @default(read)
  lastUsedAt  DateTime?     @map("last_used_at")
  expiresAt   DateTime?     @map("expires_at")
  revokedAt   DateTime?     @map("revoked_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
  @@map("api_tokens")
}

model Webhook {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  url          String
  /// HMAC-SHA256 signing secret, shown once.
  secret       String
  /// Event names, e.g. ["issue.created", "comment.created"].
  events       String[]
  active       Boolean  @default(true)
  /// Consecutive failed deliveries; the hook is disabled after too many.
  failureCount Int      @default(0) @map("failure_count")
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  deliveries WebhookDelivery[]

  @@index([workspaceId])
  @@map("webhooks")
}

enum WebhookDeliveryStatus {
  pending
  delivered
  failed
}

/// Outbox row per event per hook; the worker delivers and retries with backoff.
model WebhookDelivery {
  id             String                @id @default(cuid())
  webhookId      String                @map("webhook_id")
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(pending)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now()) @map("next_attempt_at")
  responseStatus Int?                  @map("response_status")
  error          String?
  createdAt      DateTime              @default(now()) @map("created_at")
  deliveredAt    DateTime?             @map("delivered_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

/// Someone outside the workspace who asked for something through the portal.
model PortalRequest {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  issueId   String   @unique @map("issue_id")
  name      String
  email     String
  /// Secret for the requester's tracking link.
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue   Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@map("portal_requests")
}

enum ComponentStatus {
  operational
  degraded
  partial_outage
  major_outage
  maintenance
}

model StatusComponent {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  name        String
  description String          @default("")
  status      ComponentStatus @default(operational)
  position    Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incidents IncidentComponent[]

  @@index([workspaceId])
  @@map("status_components")
}

enum IncidentImpact {
  minor
  major
  critical
  maintenance
}

enum IncidentStatus {
  investigating
  identified
  monitoring
  resolved
}

model Incident {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  title       String
  impact      IncidentImpact @default(minor)
  status      IncidentStatus @default(investigating)
  createdById String?        @map("created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  resolvedAt  DateTime?      @map("resolved_at")

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  updates    IncidentUpdate[]
  components IncidentComponent[]

  @@index([workspaceId, createdAt])
  @@map("incidents")
}

model IncidentUpdate {
  id         String         @id @default(cuid())
  incidentId String         @map("incident_id")
  status     IncidentStatus
  body       String
  authorId   String?        @map("author_id")
  createdAt  DateTime       @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("incident_updates")
}

model IncidentComponent {
  incidentId  String @map("incident_id")
  componentId String @map("component_id")

  incident  Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  component StatusComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@id([incidentId, componentId])
  @@map("incident_components")
}
