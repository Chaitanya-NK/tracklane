// Tracklane database schema.
// Conventions: cuid string ids, camelCase fields mapped to snake_case columns, plural table names.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Key/value settings for the whole installation (e.g. schema version, feature flags).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity (managed by Better Auth — field names must match Better Auth's schema)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  /// Always stored lowercase (normalised by Better Auth and our services).
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  /// Workspace opened most recently; "/" redirects there.
  lastWorkspaceId String? @map("last_workspace_id")

  sessions          Session[]
  accounts          Account[]
  memberships       WorkspaceMember[]
  invitationsSent   WorkspaceInvitation[] @relation("InvitedBy")
  workspacesCreated Workspace[]           @relation("WorkspaceCreatedBy")
  projectsLed       Project[]             @relation("ProjectLead")
  projectsCreated   Project[]             @relation("ProjectCreatedBy")
  issuesAssigned    Issue[]               @relation("IssueAssignee")
  issuesReported    Issue[]               @relation("IssueReporter")
  comments          Comment[]
  attachments       Attachment[]
  issueActivities   IssueActivity[]
  savedFilters      SavedFilter[]
  filterFavorites   FilterFavorite[]

  @@map("users")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  /// Password hash for the "credential" provider.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Workspaces
// ─────────────────────────────────────────────────────────────────────────────

/// Mirrors WORKSPACE_ROLES in @tracklane/core.
enum WorkspaceRole {
  owner
  admin
  member
  viewer
  guest
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  /// URL segment: tracklane.app/<slug>/…
  slug        String   @unique
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy    User?                 @relation("WorkspaceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members      WorkspaceMember[]
  invitations  WorkspaceInvitation[]
  projects     Project[]
  issues       Issue[]
  savedFilters SavedFilter[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(member)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  /// Lowercased email of the invitee.
  email       String
  role        WorkspaceRole @default(member)
  /// SHA-256 of the token sent by email; the raw token is never stored.
  tokenHash   String        @unique @map("token_hash")
  invitedById String?       @map("invited_by_id")
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  revokedAt   DateTime?     @map("revoked_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([email])
  @@map("workspace_invitations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Projects and issues
// ─────────────────────────────────────────────────────────────────────────────

/// Mirrors PROJECT_TYPES in @tracklane/core.
enum ProjectType {
  scrum
  kanban
}

/// Mirrors STATUS_CATEGORIES in @tracklane/core.
enum StatusCategory {
  todo
  in_progress
  done
}

/// Mirrors ISSUE_TYPES in @tracklane/core.
enum IssueType {
  story
  task
  bug
  epic
  subtask
}

/// Mirrors PRIORITIES in @tracklane/core.
enum Priority {
  lowest
  low
  medium
  high
  highest
}

model Project {
  id            String      @id @default(cuid())
  workspaceId   String      @map("workspace_id")
  /// Prefix of issue keys (PAY → PAY-12). Unique per workspace, fixed after creation.
  key           String
  name          String
  description   String      @default("")
  type          ProjectType @default(scrum)
  leadId        String?     @map("lead_id")
  /// Last issue number handed out; incremented atomically when an issue is created.
  issueCounter  Int         @default(0) @map("issue_counter")
  /// Last sprint number handed out ("WEB Sprint 4").
  sprintCounter Int         @default(0) @map("sprint_counter")
  createdById   String?     @map("created_by_id")
  archivedAt    DateTime?   @map("archived_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      User?            @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  statuses  WorkflowStatus[]
  issues    Issue[]
  labels    Label[]
  sprints   Sprint[]

  @@unique([workspaceId, key])
  @@map("projects")
}

/// A column of the project's workflow (To Do, In Progress…). Order is `position`.
model WorkflowStatus {
  id        String         @id @default(cuid())
  projectId String         @map("project_id")
  name      String
  category  StatusCategory
  position  Int
  createdAt DateTime       @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@unique([projectId, name])
  @@map("workflow_statuses")
}

model Issue {
  id          String    @id @default(cuid())
  /// Denormalised from the project so cross-project queries ("assigned to me") stay cheap.
  workspaceId String    @map("workspace_id")
  projectId   String    @map("project_id")
  /// Sequential per project; the issue key is `${project.key}-${number}`.
  number      Int
  type        IssueType @default(task)
  title       String
  /// Markdown.
  description String    @default("")
  statusId    String    @map("status_id")
  priority    Priority  @default(medium)
  assigneeId  String?   @map("assignee_id")
  reporterId  String?   @map("reporter_id")
  /// Epic for stories/tasks/bugs, or the parent of a subtask.
  parentId    String?   @map("parent_id")
  /// Planned start (timeline). Due date is the planned end.
  startDate   DateTime? @map("start_date") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date
  /// Story points.
  estimate    Int?
  /// Rank within the project: one ordering shared by the board and the backlog.
  position    Float     @default(0)
  /// Null = in the backlog.
  sprintId    String?   @map("sprint_id")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status      WorkflowStatus  @relation(fields: [statusId], references: [id], onDelete: Restrict)
  assignee    User?           @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter    User?           @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  parent      Issue?          @relation("IssueParent", fields: [parentId], references: [id], onDelete: SetNull)
  sprint      Sprint?         @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  children    Issue[]         @relation("IssueParent")
  labels      IssueLabel[]
  comments    Comment[]
  attachments Attachment[]
  activities  IssueActivity[]

  @@unique([projectId, number])
  @@index([workspaceId, assigneeId])
  @@index([projectId, statusId])
  @@index([parentId])
  @@index([sprintId])
  @@index([projectId, position])
  @@map("issues")
}

model Label {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  name      String
  /// One of the palette names in @tracklane/core (LABEL_COLORS).
  color     String   @default("gray")
  createdAt DateTime @default(now()) @map("created_at")

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  IssueLabel[]

  @@unique([projectId, name])
  @@map("labels")
}

model IssueLabel {
  issueId String @map("issue_id")
  labelId String @map("label_id")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId])
  @@map("issue_labels")
}

model Comment {
  id        String    @id @default(cuid())
  issueId   String    @map("issue_id")
  authorId  String?   @map("author_id")
  /// Markdown.
  body      String
  editedAt  DateTime? @map("edited_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
  @@map("comments")
}

model Attachment {
  id          String   @id @default(cuid())
  issueId     String   @map("issue_id")
  uploaderId  String?  @map("uploader_id")
  filename    String
  contentType String   @map("content_type")
  /// Bytes.
  size        Int
  /// Location in the storage driver (see apps/web/src/server/storage).
  storageKey  String   @unique @map("storage_key")
  createdAt   DateTime @default(now()) @map("created_at")

  issue    Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploader User? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([issueId])
  @@map("attachments")
}

/// The issue's history tab: one row per change. Values are stored as display text so history
/// stays readable after statuses, labels or people are renamed or removed.
model IssueActivity {
  id        String   @id @default(cuid())
  issueId   String   @map("issue_id")
  actorId   String?  @map("actor_id")
  /// created | updated | commented | attachment_added | attachment_removed
  action    String
  field     String?
  fromValue String?  @map("from_value")
  toValue   String?  @map("to_value")
  createdAt DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
  @@map("issue_activities")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sprints
// ─────────────────────────────────────────────────────────────────────────────

enum SprintState {
  planned
  active
  completed
}

model Sprint {
  id               String      @id @default(cuid())
  projectId        String      @map("project_id")
  name             String
  goal             String      @default("")
  state            SprintState @default(planned)
  startDate        DateTime?   @map("start_date") @db.Date
  endDate          DateTime?   @map("end_date") @db.Date
  startedAt        DateTime?   @map("started_at")
  completedAt      DateTime?   @map("completed_at")
  /// Snapshot when the sprint starts / completes, for velocity and sprint reports.
  committedPoints  Int?        @map("committed_points")
  completedPoints  Int?        @map("completed_points")
  completedIssues  Int?        @map("completed_issues")
  incompleteIssues Int?        @map("incomplete_issues")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId, state])
  @@map("sprints")
}

// ─────────────────────────────────────────────────────────────────────────────
// Saved filters
// ─────────────────────────────────────────────────────────────────────────────

/// A named TQL query. Private to its owner unless shared with the workspace.
model SavedFilter {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  ownerId     String   @map("owner_id")
  name        String
  description String   @default("")
  query       String
  shared      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  favorites FilterFavorite[]

  @@index([workspaceId, ownerId])
  @@map("saved_filters")
}

/// A user's starred filters (theirs or shared ones).
model FilterFavorite {
  filterId  String   @map("filter_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  filter SavedFilter @relation(fields: [filterId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([filterId, userId])
  @@index([userId])
  @@map("filter_favorites")
}
