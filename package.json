{
  "name": "tracklane",
  "private": true,
  "description": "Tracklane — a self-hostable, Jira-style project management platform built with Next.js and shadcn/ui.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @tracklane/db generate",
    "db:migrate": "pnpm --filter @tracklane/db migrate:dev",
    "db:seed": "pnpm --filter @tracklane/db seed",
    "db:studio": "pnpm --filter @tracklane/db studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "turbo": "^2.6.0",
    "typescript": "^5.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,css,yml,yaml}": "prettier --write"
  }
}
